# Copy this file to .env and fill in the keys for the providers you want.
# Only models whose key is set appear in the app's model picker.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Any other LiteLLM model, comma separated: https://docs.litellm.ai/docs/providers
# EXTRA_MODELS=mistral/mistral-large-latest,xai/grok-4

# Local models: run Ollama and every installed model shows up automatically.
# OLLAMA_API_BASE=http://localhost:11434

# Where code runs when you press Run:
#   local  = a subprocess on this machine (fast, for your own testing)
#   docker = a throwaway container with no network, 512 MB RAM, 1 CPU
RUNNER=local
# DOCKER_IMAGE=python:3.12-slim
